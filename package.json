{
  "name": "navio-browser",
  "version": "1.2.2",
  "description": "Navio - Futuristic AI-powered browser with built-in intelligence",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnormousHammer/Navio.git"
  },
  "bugs": {
    "url": "https://github.com/EnormousHammer/Navio/issues"
  },
  "homepage": "https://github.com/EnormousHammer/Navio#readme",
  "scripts": {
    "test": "node tools/run-node-tests.cjs test",
    "test:e2e": "node tools/run-node-tests.cjs e2e",
    "test:e2e:assistant": "node --test ./e2e/assistant-toggle.test.js",
    "lint": "eslint electron/pii-redact.js electron/navio-crash-reporter.js electron/config-store.js electron/gmail-html-sanitize.js electron/migration/ test e2e",
    "ci": "npm test && npm run lint && npx electron-forge package",
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-forge package",
    "build": "electron-forge make",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "icons": "node tools/generate-icon-ico.cjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:win:nolock": "electron-builder --win --publish never -c.directories.output=dist-eb-build",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:nolock": "electron-builder --mac --publish never -c.directories.output=dist-eb-mac-build",
    "verify:win": "npm run ci && npm run test:e2e && npm run make && (npm run dist:win || npm run dist:win:nolock)",
    "verify:mac": "npm run ci && npm run test:e2e && npm run make && (npm run dist:mac || npm run dist:mac:nolock) && node tools/verify-mac-eb-artifacts.cjs",
    "release:github": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/publish-github-release.ps1",
    "release:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/cleanup-github-releases.ps1"
  },
  "author": "Navio",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@eslint/js": "^9.15.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "electron-installer-dmg": "^5.0.1",
    "eslint": "^9.15.0",
    "globals": "^15.11.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/electron": "^5.12.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.6.2",
    "imapflow": "^1.2.18",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.4",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  }
}
