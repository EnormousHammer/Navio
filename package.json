{
  "name": "navio-browser",
  "version": "1.0.0",
  "description": "Navio - Futuristic AI-powered browser with built-in intelligence",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test ./test/*.test.js",
    "test:e2e": "node --test ./e2e/*.test.js",
    "lint": "eslint electron/pii-redact.js electron/navio-crash-reporter.js electron/config-store.js test e2e",
    "ci": "npm test && npm run lint && npx electron-forge package",
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-forge package",
    "build": "electron-forge make",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "icons": "node tools/generate-icon-ico.cjs"
  },
  "author": "Navio",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@eslint/js": "^9.15.0",
    "electron": "^35.0.0",
    "eslint": "^9.15.0",
    "globals": "^15.11.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/electron": "^5.12.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.6.2",
    "imapflow": "^1.2.18"
  }
}
